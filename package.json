{
  "name": "escola-terra-terrinha-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "verificar": "pnpm typecheck && pnpm lint && pnpm build",
    "editor:criar": "node --env-file=.env.local --import tsx scripts/gerenciar-editor.ts criar",
    "editor:revogar": "node --env-file=.env.local --import tsx scripts/gerenciar-editor.ts revogar",
    "editor:listar": "node --env-file=.env.local --import tsx scripts/gerenciar-editor.ts listar",
    "blog:migrar": "node --env-file=.env.local --import tsx scripts/migrate-blog-posts.ts",
    "firebase:login": "firebase login",
    "firebase:deploy-rules": "firebase deploy --project escola-terra-terrinha --only firestore:rules,firestore:indexes,storage:rules"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-alert-dialog": "1.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-popover": "1.1.4",
    "@radix-ui/react-progress": "1.1.1",
    "@radix-ui/react-radio-group": "1.2.2",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-tabs": "1.1.2",
    "@vercel/analytics": "1.3.1",
    "@vercel/oidc": "^3.8.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "4.1.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "lucide-react": "^0.454.0",
    "next": "16.2.0",
    "next-themes": "^0.4.6",
    "react": "^19",
    "react-day-picker": "9.8.0",
    "react-dom": "^19",
    "react-google-recaptcha-v3": "^1.11.0",
    "react-hook-form": "^7.60.0",
    "server-only": "^0.0.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.9",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.38.0",
    "eslint-config-next": "16.2.0",
    "firebase-tools": "^15.30.0",
    "postcss": "^8.5",
    "tailwindcss": "^4.1.9",
    "tsx": "^4.23.13",
    "tw-animate-css": "1.3.3",
    "typescript": "^5"
  },
  "description": "Site institucional da Escola Terra Terrinha — Vinhedo, SP.",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22"
  }
}
