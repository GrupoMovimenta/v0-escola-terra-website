# Brevo (email)
BREVO_API_KEY=

# Google reCAPTCHA v3
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Firebase — client SDK (públicas, vão para o bundle; usadas só em /admin/login)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# URL pública do site — usada para checagem de Origin (CSRF) e URLs absolutas
NEXT_PUBLIC_SITE_URL=http://localhost:3000

FIREBASE_SERVICE_ACCOUNT_B64=

# Workload Identity Federation (Vercel) — usado pelo Admin SDK quando
# FIREBASE_SERVICE_ACCOUNT_B64 está vazia e o app roda na Vercel (não existe
# localmente; local usa `gcloud auth application-default login`). Valores vêm
# do pool/provider/service account "vercel" no projeto escola-terra-terrinha
# (Console do GCP → IAM e administrador → Federação de identidade da carga de
# trabalho). Configurar como env var da Vercel (Production e Preview), não
# aqui — não são segredos, mas também não são usados fora da Vercel.
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=

# Cloud Storage — bucket das imagens do blog
FIREBASE_STORAGE_BUCKET=

# Duração da sessão do editor, em horas
SESSION_MAX_AGE_HOURS=8
