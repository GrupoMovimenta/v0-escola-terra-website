# Brevo (email)
BREVO_API_KEY=

# Google reCAPTCHA v3
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Firebase — client SDK (públicas, vão para o bundle; usadas só em /admin/login)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# URL pública do site — usada para checagem de Origin (CSRF) e URLs absolutas
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase Admin SDK — OPCIONAL. Esta organização tem
# iam.disableServiceAccountKeyCreation ligada, então normalmente não dá para
# gerar essa chave — deixe em branco e o Admin SDK usa Application Default
# Credentials automaticamente (veja lib/firebase/admin-core.ts):
#   - local: `gcloud auth application-default login` + os papéis IAM
#     datastore.user, storage.objectAdmin, firebaseauth.admin e
#     iam.serviceAccountTokenCreator (só na service account do Firebase)
#   - Vercel: credencial de Workload Identity Federation (Fase 4)
# Se algum dia a política permitir gerar a chave: Console do Firebase →
# Configurações do projeto → Contas de serviço → Gerar nova chave privada,
# depois `base64 -w0 service-account.json`. NUNCA commite o JSON.
FIREBASE_SERVICE_ACCOUNT_B64=

# Cloud Storage — bucket das imagens do blog
FIREBASE_STORAGE_BUCKET=

# Duração da sessão do editor, em horas
SESSION_MAX_AGE_HOURS=8
