{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm build)",
      "Bash(pnpm start)",
      "Bash(npx tsc --noEmit)",
      "Bash(node --version)",
      "Bash(pnpm --version)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(curl -s -o /dev/null -w * http://localhost:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(curl -sI http://localhost:*)",
      "Bash(npx next typegen)",
      "Read(//home/workspace/v0-escola-terra-website/**)",
      "Edit(app/**)",
      "Edit(components/**)",
      "Edit(lib/**)",
      "Edit(hooks/**)",
      "Edit(types/**)",
      "Edit(styles/**)",
      "Edit(public/**)",
      "Edit(scripts/**)",
      "Edit(proxy.ts)",
      "Edit(firestore.rules)",
      "Edit(firestore.indexes.json)",
      "Edit(storage.rules)",
      "Edit(firebase.json)",
      "Edit(.firebaserc)",
      "Edit(cors.json)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:developers.google.com)",
      "WebFetch(domain:developers.brevo.com)",
      "WebFetch(domain:ui.shadcn.com)",
      "WebFetch(domain:tailwindcss.com)",
      "WebFetch(domain:zod.dev)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(gh:*)",
      "Bash(vercel:*)",
      "Bash(docker:*)",
      "Bash(docker compose:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(npm install:*)",
      "Edit(next.config.mjs)",
      "Edit(package.json)",
      "Edit(Dockerfile)",
      "Edit(docker-compose.yml)",
      "Edit(vercel.json)",
      "Edit(app/politica/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/*-service-account*.json)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/id_rsa*)",
      "Read(./.git/config)",
      "Read(./node_modules/**)",
      "Read(./.next/**)",
      "Read(./.pnpm-store/**)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.*.local)",
      "Edit(./**/*-service-account*.json)",
      "Edit(./.git/**)",
      "Edit(./node_modules/**)",
      "Edit(./.next/**)",
      "Edit(./pnpm-lock.yaml)",
      "Edit(./package-lock.json)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(rm -rf:*)",
      "Bash(wget:*)",
      "Bash(env)",
      "Bash(printenv:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-secrets.mjs"
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-secrets.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-client-secrets.mjs"
          }
        ]
      }
    ]
  }
}
